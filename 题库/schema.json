{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/guokao-question-bank.schema.json",
  "title": "Guokao objective question bank",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "category", "title", "questionCount", "materials", "questions"],
  "properties": {
    "version": { "const": 1 },
    "category": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "questionCount": { "const": 60 },
    "materials": {
      "type": "array",
      "items": { "$ref": "#/$defs/material" }
    },
    "questions": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "publishedAt": { "type": "string", "format": "date" },
        "accessedAt": { "type": "string", "format": "date" }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "content", "sourceRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "content": { "type": "string", "minLength": 1 },
        "sourceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceRef" }
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "text"],
      "properties": {
        "key": { "enum": ["A", "B", "C", "D"] },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "subtype",
        "difficulty",
        "stem",
        "materialId",
        "options",
        "answer",
        "explanation",
        "knowledgePoints",
        "sourceRefs",
        "status"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^(politics|common-sense|verbal|quantitative|reasoning|data-analysis)-\\d{3}$" },
        "category": { "type": "string", "minLength": 1 },
        "subtype": { "type": "string", "minLength": 1 },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "stem": { "type": "string", "minLength": 1 },
        "materialId": { "type": ["string", "null"], "minLength": 1 },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            { "$ref": "#/$defs/option", "properties": { "key": { "const": "A" } } },
            { "$ref": "#/$defs/option", "properties": { "key": { "const": "B" } } },
            { "$ref": "#/$defs/option", "properties": { "key": { "const": "C" } } },
            { "$ref": "#/$defs/option", "properties": { "key": { "const": "D" } } }
          ],
          "items": false
        },
        "answer": { "enum": ["A", "B", "C", "D"] },
        "explanation": { "type": "string", "minLength": 1 },
        "knowledgePoints": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "sourceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "status": { "enum": ["draft", "reviewed"] }
      }
    }
  }
}
