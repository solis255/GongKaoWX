.home { position: relative; overflow: hidden; background: #fff; }
.hero-head { position: relative; z-index: 1; margin-top: 28rpx; }
.streak { display: inline-flex; margin-top: 24rpx; padding: 12rpx 24rpx; border-radius: 28rpx; color: #6d7784; background: #fff; box-shadow: 0 6rpx 22rpx rgba(27,78,88,.08); }
.streak text { margin: 0 8rpx; color: #11ae80; font-size: 34rpx; font-weight: 700; }
.calendar { width: 108rpx; min-height: 112rpx; padding:10rpx 0; display: flex; flex-direction:column; align-items: center; justify-content: center; border-radius: 22rpx; color: #fff; background: linear-gradient(145deg,#42c399,#52aaf2); font-weight: 700; }
.calendar text{font-size:20rpx;font-weight:500}.calendar .calendar__day{font-size:38rpx;font-weight:700;line-height:1.15}
.goal { margin-top: 54rpx; padding: 44rpx 36rpx; display: flex; align-items: center; justify-content: space-between; }
.goal__label { font-size: 28rpx; }
.goal__number { margin-top: 8rpx; font-size: 70rpx; font-weight: 700; line-height: 1; }
.goal__number text { margin-left: 8rpx; font-size: 24rpx; }
.goal__divider { width: 2rpx; height: 100rpx; background: rgba(255,255,255,.65); }
.goal__ring { width: 108rpx; height: 108rpx; display: flex; align-items: center; justify-content: center; border: 12rpx solid rgba(255,255,255,.65); border-radius: 50%; font-size: 30rpx; font-weight: 700; }
.module-list { padding: 8rpx 0; }
.module-row { min-height: 104rpx; display: flex; align-items: center; gap: 18rpx; border-bottom: 1rpx solid #eef1f2; }
.module-icon { width: 70rpx; height: 70rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; font-size: 22rpx; font-weight: 700; }
.module-icon--green { color: #0cac7d; background: rgba(29,183,138,.10); }
.module-icon--blue { color: #429ced; background: rgba(67,158,239,.11); }
.module-name { width: 142rpx; font-weight: 600; }
.module-progress { flex: 1; }
.module-count { width: 92rpx; text-align: right; font-size: 24rpx; }
.continue { margin-top: 30rpx; }
.reminder { margin-top: 28rpx; padding: 26rpx 30rpx; display: flex; align-items: center; justify-content: space-between; }
.reminder__title { margin-bottom: 8rpx; font-weight: 600; }
