.question-page{height:100vh;display:flex;flex-direction:column;background:#fff}.question-head{position:relative;flex:none;min-height:48px;padding:0 42rpx;display:flex;align-items:center;box-sizing:content-box;color:#5f6977}.question-head__back{position:absolute;left:42rpx;bottom:8px;width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;color:#273240;background:#f2f6f5;box-shadow:0 4rpx 14rpx rgba(24,67,77,.08)}.question-head__arrow{margin-top:-4rpx;font-size:52rpx;line-height:1}.question-head__title{position:absolute;left:50%;bottom:0;height:48px;display:flex;align-items:center;transform:translateX(-50%);font-size:32rpx;font-weight:700;color:#172131;white-space:nowrap}.top-progress{flex:none;padding:20rpx 42rpx}.question-scroll{flex:1;height:auto}.question-body{padding:28rpx 42rpx 190rpx}.difficulty{padding:10rpx 20rpx;border-radius:20rpx;color:#e8980b;background:#fff6e6}.material{margin-top:28rpx;padding:24rpx;border-radius:20rpx;background:#f5f9fb;white-space:pre-wrap;line-height:1.75}.stem{margin-top:34rpx;font-size:31rpx;line-height:1.9;white-space:pre-wrap}.options{margin-top:26rpx}.option{min-height:108rpx;margin-bottom:22rpx;padding:20rpx 26rpx;display:flex;align-items:center;gap:24rpx;border:2rpx solid #dfe5e9;border-radius:24rpx;box-sizing:border-box}.option--selected{border-color:#12ad80;background:rgba(24,183,137,.055)}.option-key{flex:none;width:62rpx;height:62rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;color:#0fa97d;background:rgba(27,183,138,.1);font-size:30rpx}.option--selected .option-key{color:#fff;background:#16b486}.option-text{font-size:28rpx;line-height:1.55}.answer-bar{position:fixed;left:0;right:0;bottom:0;height:154rpx;padding:18rpx 42rpx calc(18rpx + env(safe-area-inset-bottom));display:flex;align-items:center;gap:20rpx;border-top:1rpx solid #edf0f2;background:#fff;box-sizing:border-box}.utility{width:78rpx;display:flex;align-items:center;justify-content:center;color:#7a8491;font-size:23rpx}.utility--card{color:#0ca77b}.submit{flex:1;height:92rpx;font-size:30rpx}
