<view class="question-page"><view class="question-head" style="padding-top: {{layout.contentTop}}px;"><view class="question-head__back" bindtap="previous" aria-role="button" aria-label="{{index===1?'返回':'上一题'}}"><text class="question-head__arrow">‹</text></view><view class="question-head__title"><text class="green">{{index}}</text> / {{total}}</view></view><view class="top-progress"><progress-bar value="{{progress}}" accent="green"></progress-bar></view>
  <scroll-view class="question-scroll" scroll-y><view class="question-body"><view class="row space-between"><view class="tag">{{question.category}} · {{question.subtype}}</view><view class="difficulty">{{question.difficulty==='easy'?'简单':question.difficulty==='hard'?'困难':question.difficulty==='medium'?'中等':'未标难度'}}</view></view>
    <view class="material" wx:if="{{material}}">{{material.content}}</view><view class="stem">{{question.stem}}</view>
    <view wx:if="{{multiple}}" class="multiple-hint">多选题 · 请选择所有正确答案</view>
    <view class="options"><view class="option {{item.selected?'option--selected':''}}" wx:for="{{options}}" wx:key="key" data-key="{{item.key}}" bindtap="select"><view class="option-key">{{item.key}}</view><view class="option-text">{{item.text}}</view><view wx:if="{{multiple}}" class="option-check">{{item.selected?'✓':''}}</view></view></view>
  </view></scroll-view>
  <view class="answer-bar"><view class="utility" bindtap="toggleFavorite"><text>{{favorite?'已收藏':'收藏'}}</text></view><view class="utility utility--card" bindtap="openCard"><text>题卡</text></view><button class="primary-button submit" disabled="{{!canSubmit}}" bindtap="submit">提交答案</button></view>
</view>
