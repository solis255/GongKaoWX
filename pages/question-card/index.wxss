.card-page{background:#fff;padding-top:0}.card-summary{margin-top:24rpx;padding:30rpx 18rpx;display:flex;justify-content:space-around;text-align:center}.card-summary>view{display:flex;flex-direction:column;gap:8rpx}.summary-number{font-size:42rpx;font-weight:700}.wrong-text{color:#ef6b64}.card-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:24rpx}.card-number{height:88rpx;display:flex;align-items:center;justify-content:center;border-radius:22rpx;background:#eef1f3;color:#8d96a1;font-weight:700;box-sizing:border-box}.card-number--correct{color:#fff;background:#20b88d}.card-number--wrong{color:#fff;background:#ef6b64}.card-number--current{border:4rpx solid #fff;box-shadow:0 0 0 5rpx rgba(32,184,141,.32)}.legend{margin-top:52rpx;display:grid;grid-template-columns:repeat(2,1fr);gap:22rpx;color:#7c8591}.legend>view{display:flex;align-items:center;gap:12rpx}.dot{width:22rpx;height:22rpx;border-radius:7rpx;background:#eef1f3}.dot--correct{background:#20b88d}.dot--wrong{background:#ef6b64}.dot--current{box-shadow:0 0 0 4rpx rgba(32,184,141,.32)}
