.profile{position:relative;overflow:hidden;background:#fff}.profile-bg{position:absolute;left:0;right:0;top:0;height:420rpx;background:linear-gradient(145deg,rgba(66,199,155,.2),rgba(71,166,239,.14),transparent)}.profile-head{position:relative;margin-top:42rpx;display:flex;align-items:center;gap:28rpx}.avatar{position:relative;width:150rpx;height:150rpx;flex:0 0 auto;overflow:hidden;border:8rpx solid #fff;border-radius:50%;background:#dff7f0;box-sizing:border-box}.avatar__image{width:100%;height:100%;display:block}.avatar__sun{position:absolute;top:28rpx;right:30rpx;width:34rpx;height:34rpx;border-radius:50%;background:#ffd9bd}.avatar__hill{position:absolute;left:15rpx;right:15rpx;bottom:-20rpx;height:90rpx;border-radius:60% 60% 0 0;background:#51c5a1}.profile-info{min-width:0;flex:1}.profile-name-row{display:flex;align-items:center;gap:14rpx}.profile-name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:40rpx;font-weight:700}.edit-trigger{height:48rpx;margin:0;padding:0 16rpx;flex:0 0 auto;border:0;border-radius:24rpx;color:#0daa7e;background:rgba(255,255,255,.76);font-size:22rpx;line-height:48rpx}.edit-trigger::after{border:0}.goal-chip{display:inline-flex;margin-top:18rpx;padding:10rpx 18rpx;border-radius:24rpx;color:#0daa7e;background:#fff;box-shadow:0 6rpx 20rpx rgba(27,78,88,.08)}.profile-editor{position:relative;margin-top:36rpx;padding:30rpx}.editor-title{font-size:30rpx;font-weight:700}.avatar-picker{width:100%;height:auto;margin:22rpx 0 0;padding:18rpx;display:flex;align-items:center;border:0;border-radius:22rpx;background:#f5faf8;text-align:left;line-height:1.4}.avatar-picker::after{border:0}.avatar--small{width:92rpx;height:92rpx;border-width:5rpx}.avatar--small .avatar__sun{top:16rpx;right:18rpx;width:22rpx;height:22rpx}.avatar--small .avatar__hill{left:8rpx;right:8rpx;bottom:-12rpx;height:56rpx}.avatar-picker__copy{min-width:0;margin-left:20rpx;display:flex;flex:1;flex-direction:column;color:#172131;font-size:28rpx}.avatar-picker__copy text:last-child{margin-top:4rpx;color:#8a93a0;font-size:22rpx}.avatar-picker__arrow{color:#a3abb4;font-size:40rpx}.nickname-field{height:92rpx;margin-top:20rpx;padding:0 22rpx;display:flex;align-items:center;border:2rpx solid #e5ece9;border-radius:22rpx;background:#fff;box-sizing:border-box}.field-label{margin-right:20rpx;color:#66717f}.nickname-field input{min-width:0;height:88rpx;flex:1;color:#172131}.field-count{margin-left:12rpx;color:#a0a8b1;font-size:22rpx}.profile-error{margin-top:16rpx;color:#e35e5e;font-size:24rpx}.editor-actions{margin-top:24rpx;display:flex;gap:18rpx}.editor-button{height:76rpx;margin:0;flex:1;border:0;border-radius:38rpx;font-size:28rpx;line-height:76rpx}.editor-button::after{border:0}.editor-button--cancel{color:#65717f;background:#f0f4f3}.editor-button--save{color:#fff;background:linear-gradient(105deg,#19b888,#45aaf3)}.editor-button[disabled]{opacity:.6}.metrics{position:relative;margin:64rpx 0 42rpx;display:flex;justify-content:space-around;text-align:center}.profile-editor+.metrics{margin-top:42rpx}.metrics>view{flex:1;padding:12rpx 0;border-right:1rpx solid #dfe4e7;border-radius:18rpx}.metrics>view:active{background:rgba(25,184,138,.06)}.metrics>view:last-child{border-right:0}.metrics>view>text{color:#7c8591}.metrics>view>view{margin-top:14rpx;font-size:44rpx;font-weight:700}.metrics>view>view text{margin-left:6rpx;font-size:22rpx}.menu{padding:10rpx 30rpx}.menu-row{height:112rpx;display:flex;align-items:center;gap:22rpx;border-bottom:1rpx solid #eef1f2;font-size:30rpx}.menu-row:last-child{border-bottom:0}.menu-mark{width:46rpx;height:46rpx;border-radius:14rpx}.menu-mark--green{background:rgba(29,183,138,.18)}.menu-mark--blue{background:rgba(67,158,239,.18)}.menu-more{margin-left:auto;color:#9ca4ad;font-size:24rpx}.review-note{margin-top:34rpx;text-align:center;color:#97a0aa}

@media (max-width:340px){.profile-head{gap:20rpx}.avatar{width:126rpx;height:126rpx}.profile-name{font-size:34rpx}.edit-trigger{padding:0 12rpx}.goal-chip{font-size:23rpx}}

.distribution-title{position:relative;margin-top:0}.distribution-card{position:relative;margin-bottom:38rpx;padding:30rpx}.distribution-summary{margin-bottom:20rpx;color:#7c8591;font-size:25rpx}.distribution-summary text{color:#11aa7d;font-size:34rpx;font-weight:700}.distribution-empty{padding:42rpx 12rpx;text-align:center}.distribution-empty__icon{width:90rpx;height:90rpx;margin:0 auto 24rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:linear-gradient(145deg,rgba(25,184,138,.12),rgba(63,169,237,.12))}.distribution-empty__icon view{width:32rpx;height:32rpx;border:8rpx solid rgba(25,184,138,.42);border-top-color:#3fa9ed;border-radius:50%}.distribution-empty__title{font-size:29rpx;font-weight:600}.distribution-empty__hint{margin-top:12rpx;color:#929ba6;font-size:24rpx;line-height:1.55}
