.profile{position:relative;overflow:hidden;background:#fff}.profile-bg{position:absolute;left:0;right:0;top:0;height:420rpx;background:linear-gradient(145deg,rgba(66,199,155,.2),rgba(71,166,239,.14),transparent)}.profile-head{position:relative;margin-top:42rpx;display:flex;align-items:center;gap:32rpx}.avatar{position:relative;width:150rpx;height:150rpx;overflow:hidden;border:8rpx solid #fff;border-radius:50%;background:#dff7f0}.avatar__sun{position:absolute;top:28rpx;right:30rpx;width:34rpx;height:34rpx;border-radius:50%;background:#ffd9bd}.avatar__hill{position:absolute;left:15rpx;right:15rpx;bottom:-20rpx;height:90rpx;border-radius:60% 60% 0 0;background:#51c5a1}.profile-name{font-size:40rpx;font-weight:700}.goal-chip{display:inline-flex;margin-top:18rpx;padding:10rpx 18rpx;border-radius:24rpx;color:#0daa7e;background:#fff;box-shadow:0 6rpx 20rpx rgba(27,78,88,.08)}.metrics{position:relative;margin:64rpx 0 42rpx;display:flex;justify-content:space-around;text-align:center}.metrics>view{flex:1;padding:12rpx 0;border-right:1rpx solid #dfe4e7;border-radius:18rpx}.metrics>view:active{background:rgba(25,184,138,.06)}.metrics>view:last-child{border-right:0}.metrics>view>text{color:#7c8591}.metrics>view>view{margin-top:14rpx;font-size:44rpx;font-weight:700}.metrics>view>view text{margin-left:6rpx;font-size:22rpx}.menu{padding:10rpx 30rpx}.menu-row{height:112rpx;display:flex;align-items:center;gap:22rpx;border-bottom:1rpx solid #eef1f2;font-size:30rpx}.menu-row:last-child{border-bottom:0}.menu-mark{width:46rpx;height:46rpx;border-radius:14rpx}.menu-mark--green{background:rgba(29,183,138,.18)}.menu-mark--blue{background:rgba(67,158,239,.18)}.menu-more{margin-left:auto;color:#9ca4ad;font-size:24rpx}.review-note{margin-top:34rpx;text-align:center;color:#97a0aa}
