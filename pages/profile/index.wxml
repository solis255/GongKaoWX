<view class="page profile" style="padding-top: {{layout.contentTop}}px;">
  <view class="profile-bg"></view>
  <view class="profile-head">
    <view class="avatar">
      <image wx:if="{{avatarPath}}" class="avatar__image" src="{{avatarPath}}" mode="aspectFill" data-scope="saved" binderror="handleAvatarError"></image>
      <block wx:else><view class="avatar__sun"></view><view class="avatar__hill"></view></block>
    </view>
    <view class="profile-info">
      <view class="profile-name-row">
        <view class="profile-name">{{nickname}}</view>
        <button class="edit-trigger" bindtap="startEdit">编辑资料</button>
      </view>
      <view class="muted">连续学习 <text class="green">{{streak}}</text> 天</view>
      <view class="goal-chip">目标：{{examConfigured?examConfig.name:'未设置考试'}}</view>
    </view>
  </view>

  <view wx:if="{{editing}}" class="card profile-editor">
    <view class="editor-title">编辑个人资料</view>
    <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="chooseAvatar">
      <view class="avatar avatar--small">
        <image wx:if="{{draftAvatarPath}}" class="avatar__image" src="{{draftAvatarPath}}" mode="aspectFill" data-scope="draft" binderror="handleAvatarError"></image>
        <block wx:else><view class="avatar__sun"></view><view class="avatar__hill"></view></block>
      </view>
      <view class="avatar-picker__copy"><text>更换头像</text><text>仅保存在本机</text></view>
      <text class="avatar-picker__arrow">›</text>
    </button>
    <view class="nickname-field">
      <text class="field-label">昵称</text>
      <input type="nickname" value="{{draftNickname}}" maxlength="20" placeholder="请输入昵称" confirm-type="done" bindinput="inputNickname" bindconfirm="saveProfile"/>
      <text class="field-count">{{draftNickname.length}}/20</text>
    </view>
    <view wx:if="{{profileError}}" class="profile-error">{{profileError}}</view>
    <view class="editor-actions">
      <button class="editor-button editor-button--cancel" disabled="{{saving}}" bindtap="cancelEdit">取消</button>
      <button class="editor-button editor-button--save" loading="{{saving}}" disabled="{{saving}}" bindtap="saveProfile">保存</button>
    </view>
  </view>

  <view class="metrics"><view bindtap="openTotal"><text>累计</text><view>{{total}}<text>题</text></view></view><view bindtap="openAccuracy"><text>正确率</text><view>{{accuracy}}<text>%</text></view></view><view bindtap="openFavorites"><text>收藏</text><view>{{favorites}}<text>题</text></view></view></view>
  <view class="section-title distribution-title">今日刷题分布</view>
  <view class="card distribution-card">
    <block wx:if="{{todayDistribution.length}}">
      <view class="distribution-summary">今日共完成 <text>{{todayDistributionTotal}}</text> 题</view>
      <pie-chart items="{{todayDistribution}}"></pie-chart>
    </block>
    <view wx:else class="distribution-empty">
      <view class="distribution-empty__icon"><view></view></view>
      <view class="distribution-empty__title">今天还没有刷题记录</view>
      <view class="distribution-empty__hint">完成一道题后，这里会显示今日各科占比</view>
    </view>
  </view>
  <view class="section-title exam-setting-title">考试设置</view>
  <view class="card exam-setting-card">
    <block wx:if="{{!examEditing}}">
      <view class="exam-setting-view">
        <view wx:if="{{examConfigured}}" class="exam-setting-copy">
          <view class="exam-setting-label">当前考试目标</view>
          <view class="exam-setting-name">{{examConfig.name}}</view>
          <view class="exam-setting-date">考试日期·{{examConfig.date}}</view>
        </view>
        <view wx:else class="exam-setting-copy">
          <view class="exam-setting-name">还未设置考试</view>
          <view class="exam-setting-date">设置后首页会显示考试倒计时</view>
        </view>
        <button class="exam-setting-edit" bindtap="startEditExam">{{examConfigured?'修改':'设置'}}</button>
      </view>
    </block>
    <block wx:else>
      <view class="exam-field">
        <view class="exam-field__label">考试名称</view>
        <view class="exam-field__control">
          <input type="text" value="{{draftExamName}}" maxlength="30" placeholder="例如：2027 国家公务员考试" confirm-type="done" bindinput="inputExamName"/>
          <text>{{draftExamName.length}}/30</text>
        </view>
      </view>
      <view class="exam-field">
        <view class="exam-field__label">考试日期</view>
        <picker mode="date" value="{{draftExamDate}}" bindchange="changeExamDate">
          <view class="exam-date-picker"><text>{{draftExamDate||'请选择日期'}}</text><text>选择 ›</text></view>
        </picker>
      </view>
      <view wx:if="{{examError}}" class="exam-error">{{examError}}</view>
      <view class="exam-setting-actions">
        <button class="exam-action exam-action--cancel" disabled="{{examSaving}}" bindtap="cancelEditExam">取消</button>
        <button class="exam-action exam-action--save" loading="{{examSaving}}" disabled="{{examSaving}}" bindtap="saveExamConfig">保存</button>
      </view>
      <button wx:if="{{examConfigured}}" class="exam-clear" disabled="{{examSaving}}" bindtap="clearExamConfig">清除考试设置</button>
    </block>
  </view>
  <view class="card menu"><view class="menu-row" wx:for="{{menu}}" wx:key="label" data-index="{{index}}" bindtap="openMenu"><view class="menu-mark menu-mark--{{index%2?'blue':'green'}}"></view><text>{{item.label}}</text><text class="menu-more">查看</text></view></view>
  <view class="review-note">题库内容持续复核中</view>
</view>
<bottom-nav active="profile"></bottom-nav>
