.goal-page{background:#fff;padding-top:0}.title-block{margin-top:32rpx}.target-card{margin-top:48rpx;padding:50rpx 32rpx}.target-value{display:flex;align-items:flex-end;justify-content:center;color:#8a93a0}.target-value input{width:220rpx;height:120rpx;text-align:center;color:#12ad80;font-size:82rpx;font-weight:700}.target-value text{padding-bottom:24rpx}.choices{display:grid;grid-template-columns:repeat(4,1fr);gap:16rpx;margin-top:42rpx}.choice{padding:22rpx 0;text-align:center;border:2rpx solid transparent;border-radius:22rpx;background:#f5f8f7}.choice--active{color:#0ba87b;border-color:#1ab88a;background:rgba(25,184,138,.08);font-weight:700}.error{margin-top:24rpx;text-align:center;color:#ef6a6a}.save{margin-top:70rpx}
