.bank { position: relative; overflow: hidden; background: #fff; }
.segmented { margin: 50rpx 0 34rpx; padding: 8rpx; display: flex; }
.segment { flex: 1; height: 76rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; color: #7c8591; font-size: 30rpx; font-weight: 600; }
.segment--active { color: #fff; background: linear-gradient(100deg,#3fc79a,#3fa9ed); }
.bank-list { padding: 16rpx 28rpx; }
.bank-row { min-height: 132rpx; display: flex; align-items: center; gap: 18rpx; border-bottom: 1rpx solid #eef1f2; }
.bank-row:last-child { border-bottom: 0; }
.module-icon { width: 76rpx; height: 76rpx; display:flex;align-items:center;justify-content:center;border-radius:20rpx;font-size:22rpx;font-weight:700; }
.module-icon--green{color:#0cac7d;background:rgba(29,183,138,.1)}.module-icon--blue{color:#429ced;background:rgba(67,158,239,.11)}
.bank-info { width: 190rpx; }.bank-name{font-weight:600;margin-bottom:8rpx}.bank-progress{flex:1}.recommend{margin-top:30rpx;padding:28rpx;display:flex;align-items:center;justify-content:space-between}.recommend__title{font-weight:700;margin-bottom:8rpx}
.range-check{margin-left:auto;padding:10rpx 18rpx;border-radius:20rpx;color:#8a93a0;background:#f4f6f7;font-size:22rpx}.range-check--active{color:#0ba77b;background:rgba(25,184,138,.1)}.random-start{margin-top:34rpx}
.import-link{position:relative;z-index:1;padding:14rpx 22rpx;border-radius:24rpx;color:#0aa87a;background:rgba(25,184,138,.1);font-size:24rpx;font-weight:600}.user-tag{margin-left:6rpx;padding:4rpx 9rpx;border-radius:10rpx;color:#fff;background:#44a9ed;font-size:18rpx;font-weight:500}.bank-count{min-width:110rpx;text-align:right}.bank-actions{display:flex;justify-content:flex-end;gap:18rpx;margin-top:12rpx;color:#439de8;font-size:21rpx}.bank-actions .danger{color:#e06a6a}.bank-row--user{min-height:154rpx}.bank-tools{display:flex;justify-content:space-between;margin-top:28rpx;padding:0 8rpx;color:#6f7f8e;font-size:24rpx}
.subject-group{margin-top:28rpx}.subject-heading{padding:0 8rpx 14rpx;display:flex;align-items:center;justify-content:space-between;font-weight:700}.subject-heading text{color:#8a94a0;font-size:22rpx;font-weight:400}.subject-select{margin:5rpx 0;color:#3d99e6;font-size:21rpx}.empty-bank{margin-top:32rpx;padding:54rpx 34rpx;text-align:center}.empty-title{margin-bottom:12rpx;font-size:32rpx;font-weight:700}.empty-bank button{margin-top:30rpx}.bank-info{width:220rpx}.bank-tools{gap:22rpx}
