<view class="page bank" style="padding-top: {{layout.contentTop}}px;"><view class="fade-top"></view>
  <view class="row space-between"><view><view class="title">题库</view><view class="subtitle">按自定义科目管理私人题库</view></view><view class="import-link" bindtap="importBank">导入 JSON</view></view>
  <view class="segmented card"><view class="segment {{mode==='module'?'segment--active':''}}" data-mode="module" bindtap="changeMode">题库练习</view><view class="segment {{mode==='random'?'segment--active':''}}" data-mode="random" bindtap="changeMode">随机练习</view></view>
  <view wx:if="{{!modules.length}}" class="card empty-bank"><view class="empty-title">还没有题库</view><view class="muted">先创建科目，再导入 JSON 题库开始练习。</view><button class="primary-button" bindtap="importBank">导入第一个题库</button></view>
  <view wx:for="{{subjectGroups}}" wx:key="key" wx:for-item="group" class="subject-group">
    <view class="subject-heading"><view>{{group.name}}</view><text>{{group.bankCount}} 个题库 · {{group.questionCount}} 题</text></view>
    <view class="card bank-list">
      <view class="bank-row" wx:for="{{group.banks}}" wx:key="key" data-key="{{item.key}}" bindtap="openModule"><view class="module-icon module-icon--{{item.accent}}">{{item.shortName}}</view><view class="bank-info"><view class="bank-name">{{item.name}}</view><picker mode="selector" range="{{subjectNames}}" value="{{item.subjectIndex}}" data-key="{{item.key}}" catchtap="noop" bindchange="changeSubject"><view class="subject-select">科目：{{item.subjectName}}⌄</view></picker><view class="muted">{{item.questionCount}} 题</view></view><view wx:if="{{mode==='module'}}" class="bank-progress"><progress-bar value="{{item.progress}}" accent="{{item.accent}}"></progress-bar></view><view wx:if="{{mode==='module'}}" class="bank-count"><text class="{{item.accent}}">{{item.done}}/{{item.questionCount}}</text><view class="bank-actions"><text data-key="{{item.key}}" catchtap="exportBank">导出</text><text class="danger" data-key="{{item.key}}" catchtap="trashBank">删除</text></view></view><view wx:else class="range-check {{item.selected?'range-check--active':''}}">{{item.selected?'已选':'选择'}}</view></view>
    </view>
  </view>
  <button wx:if="{{mode==='random'&&modules.length}}" class="primary-button random-start" bindtap="startRandom">开始综合随机练习</button>
  <view class="bank-tools"><view bindtap="manageSubjects">管理科目</view><view bindtap="importBank">＋ 导入题库</view><view bindtap="openTrash">回收站{{trashCount?'（'+trashCount+'）':''}}</view></view>
</view><bottom-nav active="bank"></bottom-nav>
