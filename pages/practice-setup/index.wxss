.setup{background:#fff;padding-top:0}.module-hero{margin-top:26rpx;padding:36rpx;display:flex;align-items:center;gap:30rpx}.module-symbol{width:90rpx;height:90rpx;display:flex;align-items:center;justify-content:center;border-radius:22rpx;color:#0ba77b;background:rgba(255,255,255,.82);font-weight:700}.module-name{font-size:34rpx;font-weight:700}.module-progress{margin-top:12rpx;color:rgba(255,255,255,.9)}.setting-card,.switches{margin-top:32rpx;padding:16rpx 28rpx 32rpx}.chips{display:flex;gap:18rpx}.choice{flex:1;height:96rpx;display:flex;align-items:center;justify-content:center;border:2rpx solid transparent;border-radius:24rpx;background:#f6f8f9;font-size:28rpx}.choice--active{color:#0cac7d;border-color:#1ab88a;background:rgba(25,184,138,.06);font-weight:700}.order-row{display:flex;gap:20rpx}.order{flex:1;height:96rpx;display:flex;align-items:center;justify-content:center;border:2rpx solid transparent;border-radius:24rpx;background:#f6f8f9}.switch-row{height:104rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #eef1f2}.switch-row:last-child{border-bottom:0}.start{margin-top:70rpx}
