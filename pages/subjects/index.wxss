.subjects-page{background:#f8fbfa}.create-card{padding:30rpx}.create-row{display:flex;align-items:center;gap:18rpx}.create-row input{flex:1;height:82rpx;padding:0 22rpx;border:2rpx solid #dfe7e5;border-radius:20rpx;background:#fff;box-sizing:border-box}.create-row button{width:150rpx;height:82rpx;font-size:26rpx}.tip{margin:24rpx 8rpx;line-height:1.65}.subject-list{padding:8rpx 28rpx}.subject-row{min-height:118rpx;display:flex;align-items:center;gap:18rpx;border-bottom:1rpx solid #edf1f1}.subject-row:last-child{border-bottom:0}.subject-icon{width:68rpx;height:68rpx;display:flex;align-items:center;justify-content:center;border-radius:18rpx;color:#0ba77b;background:rgba(25,184,138,.1);font-size:21rpx;font-weight:700}.subject-info{flex:1;font-weight:600}.subject-info text{display:block;margin-top:7rpx;font-size:22rpx;font-weight:400}.subject-action{padding:12rpx;color:#3998e9;font-size:24rpx}.subject-action.danger{color:#dc6868}.empty{padding:120rpx 30rpx;text-align:center;line-height:1.7}
