.trash-page{background:#f8fbfa}.trash-list{display:flex;flex-direction:column;gap:20rpx}.trash-item{padding:30rpx;display:flex;align-items:center;justify-content:space-between}.trash-name{margin-bottom:10rpx;font-weight:700}.trash-actions{display:flex;gap:24rpx;color:#10a97d;font-size:24rpx}.trash-actions .danger{color:#d85d5d}.empty{padding-top:180rpx;text-align:center}.empty-title{margin-bottom:16rpx;font-size:34rpx;font-weight:700}
