.stats{background:#fff;padding-top:0}.stats-hero{margin-top:24rpx;padding:38rpx;display:flex;align-items:center;justify-content:space-around}.stats-hero>view>text{font-size:28rpx}.stats-hero>view>view{margin-top:10rpx;font-size:70rpx;font-weight:700}.stats-hero>view>view text{margin-left:8rpx;font-size:24rpx}.line{width:2rpx;height:96rpx;background:rgba(255,255,255,.65)}.chart,.ability,.totals{margin-top:28rpx;padding:18rpx 28rpx 30rpx}.bars{height:290rpx;display:flex;align-items:flex-end;justify-content:space-around}.bar-col{height:250rpx;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:10rpx}.bar{width:30rpx;min-height:24rpx;border-radius:14rpx 14rpx 0 0;background:#53c6a4}.bar--today{background:#4b9ff0}.bar-value{color:#697381;font-size:22rpx}.ability-row{height:82rpx;display:flex;align-items:center;gap:18rpx}.ability-name{width:140rpx}.ability-progress{flex:1}.totals>view{height:86rpx;border-bottom:1rpx solid #eef1f2}.totals>view:last-child{border-bottom:0}.totals .green,.totals .blue{font-size:34rpx;font-weight:700}
