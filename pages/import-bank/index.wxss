.import-page{background:#f8fbfa}.upload-card{margin-top:70rpx;padding:80rpx 40rpx;text-align:center}.upload-icon{width:128rpx;height:128rpx;margin:0 auto 30rpx;display:flex;align-items:center;justify-content:center;border-radius:34rpx;color:#fff;background:linear-gradient(120deg,#20b88d,#43a9ef);font-size:27rpx;font-weight:700}.upload-title{margin-bottom:16rpx;font-size:34rpx;font-weight:700}.reading{padding-top:180rpx;text-align:center;color:#6f7985}.reading-dot{width:30rpx;height:30rpx;margin:0 auto 24rpx;border:7rpx solid #d9eee8;border-top-color:#18ae82;border-radius:50%}.preview{padding-bottom:40rpx}.file-card{padding:28rpx}.file-name{max-width:480rpx;margin-bottom:8rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:700}.change{color:#0aa97b}.summary-grid{margin:26rpx 0;display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.summary-grid .card{padding:28rpx;text-align:center}.summary-grid text{display:block;margin-bottom:8rpx;font-size:42rpx;font-weight:700}.summary-grid .valid text{color:#10ad80}.summary-grid .warning text{color:#e17b5f}.cross-note{padding:24rpx;line-height:1.6}.issue-card{margin-top:22rpx;padding:26rpx;color:#7d5d50;font-size:24rpx;line-height:1.7}.issue-card--fatal{color:#b94f4f;background:#fff8f8}.issue-title{margin-bottom:12rpx;color:#273240;font-size:29rpx;font-weight:700}.import-note{margin:24rpx 8rpx;line-height:1.6}.import-button{margin-top:28rpx}
