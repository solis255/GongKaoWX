.analysis-page{height:100vh;display:flex;flex-direction:column;background:#fff}.analysis-scroll{flex:1;height:auto}.analysis-content{padding:22rpx 42rpx 210rpx}.material{margin-bottom:26rpx;padding:24rpx;border-radius:20rpx;background:#f5f9fb;white-space:pre-wrap;line-height:1.75}.question-summary{padding:28rpx}.summary-stem{margin-top:22rpx;line-height:1.8;white-space:pre-wrap}.analysis-options{margin-top:24rpx}.option-line{min-height:76rpx;margin-top:14rpx;padding:14rpx 18rpx;display:flex;align-items:center;gap:16rpx;border:2rpx solid #e3e8eb;border-radius:18rpx;line-height:1.55;box-sizing:border-box}.option-key{flex:none;width:48rpx;height:48rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#f1f5f5}.option-line--chosen{border-color:#4b9ff0}.option-line--correct{border-color:#18b487;background:rgba(24,180,135,.05)}.result-banner{margin-top:26rpx;padding:28rpx 34rpx;display:flex;align-items:center;justify-content:space-between;border-radius:28rpx;font-size:30rpx;font-weight:700}.result-banner--correct{color:#0aa678;background:rgba(26,183,139,.08);border:1rpx solid rgba(26,183,139,.25)}.result-banner--wrong{color:#e45e57;background:rgba(237,96,87,.08);border:1rpx solid rgba(237,96,87,.25)}.result-banner text{font-size:36rpx}.explanation{margin-top:26rpx;padding:10rpx 32rpx 32rpx}.correct-answer{font-size:30rpx;font-weight:600}.correct-answer text{margin-left:12rpx;color:#10ad80;font-size:40rpx}.explanation-text{margin-top:22rpx;line-height:1.9;white-space:pre-wrap}.knowledge-title{margin-top:24rpx}.knowledge{display:flex;flex-wrap:wrap;gap:18rpx;margin-top:18rpx}.source-row{margin-top:26rpx;padding:28rpx;display:flex;justify-content:space-between;border:1rpx solid rgba(65,157,238,.26);border-radius:26rpx;color:#348fe2}.source-list{margin-top:18rpx;padding:8rpx 28rpx}.source-item{padding:24rpx 0;border-bottom:1rpx solid #edf0f2}.source-item:last-child{border-bottom:0}.source-title{max-width:460rpx;font-weight:600}.source-item .muted{margin-top:10rpx;font-size:23rpx}.actions{position:fixed;z-index:5;left:0;right:0;bottom:0;padding:18rpx 42rpx calc(18rpx + env(safe-area-inset-bottom));display:flex;align-items:center;gap:16rpx;border-top:1rpx solid #edf0f2;background:#fff}.actions>.outline-button,.actions>.primary-button{flex:1;height:92rpx;font-size:27rpx}.card-action{width:92rpx;height:92rpx;display:flex;align-items:center;justify-content:center;border:2rpx solid #20b88d;border-radius:28rpx;color:#0ca77b;background:#fff;font-weight:600;box-sizing:border-box}
.option-line--wrong{border-color:#e45e57;background:rgba(237,96,87,.06)}
