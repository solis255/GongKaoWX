<view class="analysis-page">
  <app-header title="{{index}} / {{total}}"></app-header>
  <scroll-view class="analysis-scroll" scroll-y>
    <view class="analysis-content">
      <view wx:if="{{material}}" class="material">{{material.content}}</view>
      <view class="card question-summary">
        <view class="row space-between"><view class="tag">{{question.category}} · {{question.subtype}}</view><view class="muted">{{questionTypeText}}</view></view>
        <view class="summary-stem">{{question.stem}}</view>
        <view class="analysis-options">
          <view wx:for="{{question.options}}" wx:key="key" class="option-line {{item.correct?'option-line--correct':''}} {{item.chosen?'option-line--chosen':''}} {{item.wrong?'option-line--wrong':''}}">
            <view class="option-key">{{item.key}}</view><view>{{item.text}}</view>
          </view>
        </view>
      </view>
      <view class="result-banner {{correct?'result-banner--correct':'result-banner--wrong'}}"><view>{{correct?'回答正确':'回答错误'}}</view><view>用时 <text>{{seconds}}</text> 秒</view></view>
      <view class="card explanation">
        <view class="section-title">答案解析</view>
        <view class="correct-answer">正确答案 <text>{{answerText}}</text></view>
        <view class="explanation-text">{{question.explanation}}</view>
        <view class="muted knowledge-title">相关知识点</view>
        <view class="knowledge"><view class="tag" wx:for="{{question.knowledgePoints}}" wx:key="*this">{{item}}</view></view>
      </view>
      <view wx:if="{{sources.length}}" class="source-row" bindtap="toggleSources"><text>{{sourcesExpanded?'收起题目来源':'查看本题来源'}}</text><text>{{sourcesExpanded?'收起':'展开'}}</text></view>
      <view wx:if="{{sourcesExpanded}}" class="card source-list">
        <view class="source-item" wx:for="{{sources}}" wx:key="title" data-index="{{index}}" bindtap="copySource">
          <view class="row space-between"><text class="source-title">{{item.title}}</text><text wx:if="{{item.url}}" class="green">复制链接</text></view>
          <view class="muted">{{item.kindText}}{{item.publishedAt?' · '+item.publishedAt:''}}</view>
        </view>
      </view>
    </view>
  </scroll-view>
  <view class="actions"><view class="outline-button" bindtap="previous">{{index===1?'返回':'上一题'}}</view><view class="card-action" bindtap="openCard">题卡</view><view class="primary-button" bindtap="next">{{index===total?'完成练习':'下一题'}}</view></view>
</view>
