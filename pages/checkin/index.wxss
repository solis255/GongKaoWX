.checkin-page {
  padding-top: 0;
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
  background: #f8fbfa;
}

.summary-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 26rpx;
  padding: 34rpx 20rpx;
}

.summary-item {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: center;
}

.summary-value {
  font-size: 48rpx;
  line-height: 1;
  font-weight: 700;
}

.summary-unit {
  margin-left: 6rpx;
  font-size: 24rpx;
}

.summary-label {
  width: 100%;
  margin-top: 12rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.84);
  font-size: 23rpx;
}

.summary-divider {
  width: 2rpx;
  height: 54rpx;
  background: rgba(255, 255, 255, 0.28);
}

.calendar-card {
  margin-top: 28rpx;
  padding: 30rpx 24rpx 28rpx;
}

.month-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.month-title {
  color: #172131;
  font-size: 34rpx;
  font-weight: 700;
}

.month-arrow {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #4b5b68;
  background: #f1f7f5;
  font-size: 44rpx;
  line-height: 1;
}

.month-arrow::after,
.today-button::after {
  border: 0;
}

.today-button {
  width: 144rpx;
  height: 52rpx;
  margin: 16rpx auto 20rpx;
  padding: 0;
  border-radius: 28rpx;
  color: #0da77b;
  background: rgba(31, 184, 139, 0.09);
  font-size: 23rpx;
  line-height: 52rpx;
}

.weekday-row,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
}

.weekday {
  padding: 10rpx 0 18rpx;
  text-align: center;
  color: #98a1ab;
  font-size: 23rpx;
}

.calendar-cell {
  min-width: 0;
  height: 86rpx;
  box-sizing: border-box;
}

.calendar-day {
  display: flex;
  position: relative;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 3rpx solid transparent;
  border-radius: 20rpx;
}

.day-number {
  font-size: 28rpx;
  line-height: 1;
}

.day-count {
  max-width: 100%;
  margin-top: 8rpx;
  overflow: hidden;
  font-size: 18rpx;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.calendar-day--checked {
  color: #07946d;
  background: rgba(31, 184, 139, 0.12);
  font-weight: 600;
}

.calendar-day--today {
  border-color: #3ea9ec;
}

.calendar-day--future {
  color: #c9ced3;
  background: transparent;
}

.calendar-day--selected {
  box-shadow: inset 0 0 0 2rpx rgba(23, 33, 49, 0.18);
}

.detail-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 26rpx;
  padding: 28rpx 30rpx;
  border-left: 8rpx solid #c4ccd2;
}

.detail-card--checked {
  border-left-color: #19b888;
}

.detail-card--future {
  border-left-color: #d7dce0;
}

.detail-date {
  font-size: 29rpx;
  font-weight: 700;
}

.detail-text {
  margin-top: 9rpx;
  color: #87919d;
  font-size: 24rpx;
}

.detail-status {
  margin-left: 20rpx;
  padding: 10rpx 18rpx;
  border-radius: 22rpx;
  color: #75808d;
  background: #f0f3f4;
  font-size: 23rpx;
  white-space: nowrap;
}

.detail-card--checked .detail-status {
  color: #07946d;
  background: rgba(31, 184, 139, 0.11);
}

.rule-note {
  display: flex;
  margin-top: 26rpx;
  padding: 0 12rpx;
  align-items: center;
  justify-content: center;
  color: #8b96a0;
  font-size: 23rpx;
}

.rule-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #20b88d;
}
