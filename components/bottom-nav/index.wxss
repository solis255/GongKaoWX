.nav { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; height: 132rpx; padding-bottom: env(safe-area-inset-bottom); display: flex; align-items: center; justify-content: space-around; background: rgba(255,255,255,0.97); border-top: 1rpx solid #edf0f2; }
.nav__item { width: 25%; display: flex; flex-direction: column; align-items: center; gap: 10rpx; color: #7a8491; font-size: 25rpx; }
.nav__mark { width: 36rpx; height: 8rpx; border-radius: 8rpx; background: #cfd5da; }
.nav__item--active { color: #0db180; font-weight: 600; }
.nav__item--active .nav__mark { width: 48rpx; background: linear-gradient(90deg, #19b88a, #42aaf2); }
