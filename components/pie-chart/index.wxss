.pie-chart{display:flex;flex-direction:column;align-items:center}.pie-canvas{width:280rpx;height:280rpx;display:block}.pie-legend{width:100%;margin-top:26rpx}.legend-row{min-height:62rpx;padding:10rpx 0;display:flex;align-items:center;border-bottom:1rpx solid #eef2f1;box-sizing:border-box;font-size:25rpx}.legend-row:last-child{border-bottom:0}.legend-dot{width:18rpx;height:18rpx;margin-right:16rpx;flex:0 0 auto;border-radius:50%}.legend-name{min-width:0;padding-right:16rpx;flex:1;line-height:1.4;word-break:break-all}.legend-value{width:82rpx;flex:0 0 auto;color:#65717f;text-align:right}.legend-percent{width:86rpx;flex:0 0 auto;color:#182332;text-align:right;font-weight:600}
