page {
  min-height: 100%;
  background: #f8fbfa;
  color: #172131;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}
.page { min-height: 100vh; box-sizing: border-box; padding: 40rpx 42rpx 180rpx; }
.page--plain { background: #ffffff; }
.title { font-size: 52rpx; line-height: 1.18; font-weight: 700; letter-spacing: 1rpx; }
.subtitle { margin-top: 18rpx; color: #7b8492; font-size: 28rpx; line-height: 1.5; }
.section-title { display: flex; align-items: center; margin: 38rpx 0 24rpx; font-size: 32rpx; font-weight: 700; }
.section-title::before { content: ""; width: 8rpx; height: 34rpx; margin-right: 16rpx; border-radius: 8rpx; background: #20b88d; }
.card { background: #ffffff; border-radius: 28rpx; box-shadow: 0 10rpx 34rpx rgba(25, 78, 93, 0.07); }
.soft-card { background: linear-gradient(90deg, rgba(33, 187, 142, 0.08), rgba(67, 169, 244, 0.08)); border-radius: 26rpx; }
.gradient-card { color: #fff; background: linear-gradient(115deg, #43c59c 0%, #3fa9ed 100%); border-radius: 28rpx; box-shadow: 0 14rpx 34rpx rgba(50, 168, 194, 0.18); }
.primary-button { display: flex; align-items: center; justify-content: center; height: 104rpx; border: 0; border-radius: 54rpx; color: #fff; background: linear-gradient(105deg, #19b888 0%, #45aaf3 100%); font-size: 34rpx; font-weight: 700; box-shadow: 0 12rpx 28rpx rgba(43, 174, 181, 0.22); }
.primary-button::after { border: 0; }
.primary-button[disabled] { color: #9da6b1; background: #e9edf1; box-shadow: none; }
.outline-button { display: flex; align-items: center; justify-content: center; height: 96rpx; border: 2rpx solid #20b88d; border-radius: 28rpx; color: #12a97d; background: #fff; font-weight: 600; }
.tag { display: inline-flex; align-items: center; padding: 10rpx 20rpx; border-radius: 20rpx; color: #0da77b; background: rgba(31, 184, 139, 0.09); font-size: 24rpx; }
.muted { color: #8a93a0; }
.green { color: #10ad80; }
.blue { color: #3b9ff0; }
.row { display: flex; align-items: center; }
.space-between { justify-content: space-between; }
.fade-top { position: absolute; top: 0; right: 0; width: 460rpx; height: 260rpx; pointer-events: none; background: linear-gradient(145deg, rgba(67, 195, 155, 0.11), rgba(75, 171, 241, 0.05), transparent 72%); border-bottom-left-radius: 80%; }
