{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/user-question-bank-import.schema.json",
  "title": "私人题库导入格式",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "category", "title", "questionCount", "materials", "questions"],
  "properties": {
    "version": { "const": 1 },
    "subject": { "type": "string", "minLength": 1, "maxLength": 20 },
    "category": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "questionCount": { "type": "integer", "minimum": 1 },
    "materials": { "type": "array", "items": { "$ref": "#/$defs/material" } },
    "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "publishedAt": { "type": "string", "format": "date" },
        "accessedAt": { "type": "string", "format": "date" }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "content", "sourceRefs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "title": { "type": "string", "minLength": 1 },
        "content": { "type": "string", "minLength": 1 },
        "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "text"],
      "properties": {
        "key": { "enum": ["A", "B", "C", "D"] },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "category", "subtype", "difficulty", "stem", "materialId", "options",
        "answer", "explanation", "knowledgePoints", "sourceRefs", "status"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "type": { "enum": ["single-choice", "multiple-choice"] },
        "category": { "type": "string", "minLength": 1 },
        "subtype": { "type": "string", "minLength": 1 },
        "difficulty": { "enum": ["easy", "medium", "hard", "unknown"] },
        "stem": { "type": "string", "minLength": 1 },
        "materialId": { "type": ["string", "null"], "minLength": 1 },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            { "$ref": "#/$defs/option", "properties": { "key": { "const": "A" } } },
            { "$ref": "#/$defs/option", "properties": { "key": { "const": "B" } } },
            { "$ref": "#/$defs/option", "properties": { "key": { "const": "C" } } },
            { "$ref": "#/$defs/option", "properties": { "key": { "const": "D" } } }
          ],
          "items": false
        },
        "answer": {
          "oneOf": [
            { "enum": ["A", "B", "C", "D"] },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "uniqueItems": true,
              "items": { "enum": ["A", "B", "C", "D"] }
            }
          ]
        },
        "explanation": { "type": "string" },
        "knowledgePoints": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "status": { "enum": ["draft", "reviewed"] }
      },
      "allOf": [
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "const": "multiple-choice" } }
          },
          "then": {
            "properties": {
              "answer": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "uniqueItems": true,
                "items": { "enum": ["A", "B", "C", "D"] }
              }
            }
          },
          "else": { "properties": { "answer": { "enum": ["A", "B", "C", "D"] } } }
        }
      ]
    }
  }
}
